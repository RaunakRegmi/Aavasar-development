# API base URL — used by src/shared/lib/transport/http.ts
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Toggle MSW mock service worker (mocks/) in dev. Set to "true" to enable.
VITE_USE_MOCKS=true

# Optional sentry / analytics keys
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=

# Dev server port (default 5173)
VITE_DEV_PORT=5173
