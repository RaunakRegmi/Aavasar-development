# API base URL — used by src/shared/lib/transport/http.ts
# Production (Vercel): set this as a Vercel project env var (build-time,
# not read from this file) to the deployed Render backend, e.g.
#   VITE_API_BASE_URL=https://aavasar-development.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Toggle MSW mock service worker (mocks/) in dev. Set to "true" to enable.
# Must be "false" (or unset) in the Vercel production env — mocks would
# otherwise shadow the real API.
VITE_USE_MOCKS=true

# Optional sentry / analytics keys
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=

# Dev server port (default 5173)
VITE_DEV_PORT=5173
