# --- Runtime ---
NODE_ENV=development
PORT=8080
API_BASE_PATH=/api/v1

# --- Database ---
# Local dev: docker run --name aavasar-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5444/aavasar?schema=public"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-me-with-48-bytes-of-entropy
JWT_REFRESH_SECRET=replace-me-too-keep-distinct-from-access
JWT_ACCESS_TTL_SECONDS=900           # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000      # 30 days (legacy default)
JWT_REFRESH_TTL_REMEMBER_SECONDS=315360000   # ~10 years — "Remember me" sliding window
JWT_REFRESH_TTL_SESSION_SECONDS=86400        # 1 day — "Remember me" unchecked

# --- Frontend ---
# Used by CORS allowlist and the OAuth redirect target.
FRONTEND_ORIGIN=http://localhost:5173
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:5173/log-in?error=oauth

# --- OAuth providers ---
# All three are optional; the corresponding routes 503 if a secret is missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Uploads ---
# Local-disk storage in dev. In production, mount UPLOAD_DIR to a
# persistent volume — or swap the LocalUploadStorage adapter with an
# S3 one inside src/lib/upload.ts.
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE=/uploads
UPLOAD_MAX_AVATAR_BYTES=2097152       # 2 MB
UPLOAD_MAX_DOCUMENT_BYTES=10485760    # 10 MB

# --- Logging ---
LOG_LEVEL=info
