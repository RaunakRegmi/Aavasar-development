{
  "name": "aavasar-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aavasar — student-talent marketplace backend (Node.js + Express + Prisma).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "rate-limiter-flexible": "^5.0.3",
    "stripe": "^22.2.1",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/passport": "^1.0.16",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  }
}
